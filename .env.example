# EVERYTHING IN HERE IS FAKE, REPLACE WITH YOUR OWN VALUES
# IN A .env FILE. 

# ***** DO. NOT. COMMIT. YOUR. REAL. CREDENTIALS. TO. GITHUB. *****

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# Sender Info
FROM_NAME=Your Name
FROM_EMAIL=your_email@gmail.com

# Tracking Server
TRACKING_HOST=0.0.0.0
TRACKING_PORT=5000
# The public URL where your tracking server is accessible
# This is used to generate tracking pixel and link redirect URLs
# For local testing, use http://localhost:5000
# For production, use your public domain (e.g., https://track.yourdomain.com)
TRACKING_BASE_URL=http://localhost:5000

# Email Sending
DELAY_BETWEEN_EMAILS=10
# Path to contacts CSV file
CONTACTS_CSV=contacts.csv
# Path to email template
EMAIL_TEMPLATE=templates/email_template.html

# Database
DATABASE_PATH=email_tracker.db
